{
  "name": "eldenring-mod-assist",
  "version": "1.2.0",
  "description": "Elden Ring profile switcher, Steam integrity checker and save manager",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prettier": "prettier --write .",
    "desktop:build": "pnpm run build && cargo build --locked --release --features custom-protocol --manifest-path src-tauri/Cargo.toml && node scripts/prepare-me3.mjs",
    "test:native": "cargo test --locked --release --manifest-path src-tauri/Cargo.toml --lib"
  },
  "dependencies": {
    "@heroui/react": "^2.7.11",
    "framer-motion": "^12.23.3",
    "next": "^15.3.5",
    "next-themes": "^0.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "9",
    "eslint-config-next": "15.3.5",
    "eslint-config-prettier": "^10.1.1",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.8.3"
  }
}
